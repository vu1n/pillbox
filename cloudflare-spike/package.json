{
  "name": "pillbox-managed",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test *.test.ts *.test.mjs",
    "deploy": "wrangler deploy",
    "burnin:dry-run": "wrangler deploy -c wrangler.burnin.toml --dry-run --containers-rollout=none",
    "burnin": "node scripts/burnin-fixed-workload.mjs",
    "burnin:reconcile": "node scripts/reconcile-burnin.mjs",
    "gen:contract": "node scripts/gen-contract.mjs",
    "check:contract": "node scripts/gen-contract.mjs --check"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/sandbox": "^0.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260607.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "wrangler": "4.98.0"
  }
}
