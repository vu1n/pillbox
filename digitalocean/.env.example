# Worker environment; keep real values in .env.local or the deployment's secret store.
DIGITALOCEAN_EXECUTION_ENABLED=0
DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_AGENT_CONFIG_ID=
# Unique to this deployment/execution realm; preserve while allocations are retained.
DIGITALOCEAN_ALLOCATION_NAMESPACE=
# Existing global admission/allowance is still required; use a reviewed fresh epoch.
MANAGED_EXECUTION_ENABLED=0
MANAGED_EXECUTION_EPOCH=
MANAGED_EXECUTION_LIMIT=1

# Operator-only input for agent.example.yaml; captured in the immutable DO config.
OPENROUTER_API_KEY=
