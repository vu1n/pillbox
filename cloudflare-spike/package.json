{
  "name": "pillbox-managed",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test *.test.ts *.test.mjs",
    "smoke:ensure": "node --test ensure_session.test.mjs",
    "deploy": "wrangler deploy",
    "gen:contract": "json2ts -i contract.schema.json -o src/contract.generated.ts",
    "check:contract": "npm run gen:contract && git diff --exit-code src/contract.generated.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/sandbox": "^0.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.20.0"
  }
}
