{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>vu1n/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/runner/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\S+?=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Harness bumps stay on despite the preset turning routine bumps off; patch + minor auto-merge once CI is green",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["patch", "minor"],
      "enabled": true,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major bumps hold for human review",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "automerge": false
    }
  ]
}
