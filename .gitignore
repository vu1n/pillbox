/target
# Cross-arch build dirs (e.g. target-amd64/ from a cross build) — same
# build-artifact class as /target; one `git add -A` would otherwise stage ~1GB.
/target-*

# macOS Finder cruft.
.DS_Store

# Agent worktrees created by the Claude Code harness (locked, ephemeral).
.claude/worktrees/

# Local-only env (secrets like E2B_API_KEY for dev/test). Never commit.
.env
.env.local
.env.*.local

# Node deps (wrangler/opencode dev tooling) — never commit; a stray `npm i`
# once swept the whole tree (incl. a 100MB+ workerd binary) into history.
node_modules/

# Python bytecode + uv venvs (scripts/ghost/*)
__pycache__/
*.pyc
.venv/
scripts/eval/toolz-tasks/

# Eval + ghost run OUTPUTS — local-only. These traces (agent transcripts, and
# compose packets built from kypp memory) can carry prompt/memory content that
# must not go public. Findings get distilled into docs/memory, not the raw runs.
# Already-committed result jsonls under results/ stay tracked; this stops NEW ones.
scripts/eval/segmentation/results/*.jsonl
scripts/eval/segmentation/results/*.log
scripts/ghost/*.jsonl
scripts/ghost/*.json
scripts/ghost/*.log
