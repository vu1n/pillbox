          "default": null
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "provider",
        "model"
      ]
    },
    "ResultReady": {
      "type": "object",
      "properties": {
        "snapshotHandle": {
          "type": "string"
        }
      },
      "required": [
        "snapshotHandle"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "unspecified",
        "assistant",
        "user",
        "system"
      ]
    },
    "RunFailed": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": "integer",
          "format": "int32"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "exitCode"
      ]
    },
    "RunFinished": {
      "type": "object",
      "properties": {
        "effectiveLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectiveRuntimeLimitsEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "type": "integer",
          "format": "int32"
        },
        "resultSnapshot": {
          "type": "string"
        },
        "servedModel": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServedRunProfileEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exitCode"
      ]
    },
    "RunStarted": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "baseSnapshot": {
          "type": "string"
        },
        "parentRunId": {
          "type": "string"
        },
        "requested": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestedRunProfile"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "agent"
      ]
    },
    "SandboxDestroyed": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ]
    },
    "SandboxProvisioned": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        }
      },
      "required": [
        "image"
      ]
    },
    "Scored": {
      "description": "An **external, verifiable** grade of a session's result — produced by running\na grader against the result-snapshot (`pillbox session score --cmd …`), NOT\nself-reported by the agent. (`RunFinished` / `session done --status` is\nself-stamped → Goodhart-banned as a reward.) This is the substrate primitive\nthe optimization loops gate on: GEPA needs a coarse verifiable score, and the\n`feedback` carries the textual gradient (test output, stderr, diff) that does\nthe actual optimizing — not just the scalar.",
      "type": "object",
      "properties": {
        "criteria": {
          "description": "Per-criterion verdicts from a `--rubric` grade — the rich,\ndecomposed feedback an optimizer reflects on (which criterion failed and\nwhy), vs the single `feedback` blob. Empty for a plain `--cmd` grade.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "feedback": {
          "description": "The grader's captured output (the gradient, not just the scalar). For a\nrubric grade, a rendered per-criterion summary; `criteria` carries the\nstructured detail.",
          "type": "string"
        },
        "grader": {
          "description": "What produced the grade — the verifier command line (or a grader id).",
          "type": "string"
        },
        "passed": {
          "description": "Verifiable pass/fail = the grader's exit status (0 → `true`).",
          "type": "boolean"
        },
        "score": {
          "description": "Normalized score in `[0,1]`. A plain `--cmd` grade is binary\n(`passed` → 1.0, else 0.0); a `--rubric` grade is the fraction of\ncriteria that passed — a real gradient, not just the scalar.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "grader",
        "passed",
        "score",
        "feedback"
      ]
    },
    "ServedRunProfileEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "reasoningProfile": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "const": "reported"
            }
          },
          "required": [
            "status",
            "model"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/EvidenceUnavailableReason"
            },
            "status": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "StdStream": {
      "type": "string",
      "enum": [
        "unspecified",
        "stdout",
        "stderr"
      ]
    },
    "Thinking": {
      "description": "Reasoning/thinking content the harness surfaced for a turn. First-class\nsemantic output (the transcript exposes it discretely), `content`-class and\nlocal-only. Distinct from the MITM raw thinking body (blob-stored).",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "Todo": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/TodoStatus"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "status"
      ]
    },
    "TodoStatus": {
      "type": "string",
      "enum": [
        "unspecified",
        "pending",
        "in_progress",
        "completed"
      ]
    },
    "TodosUpdated": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Todo"
          }
        }
      },
      "required": [
        "todos"
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "input": true,
        "name": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolStatus"
        },
        "title": {
          "type": "string"
        },
        "toolCallId": {
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "name",
        "status"
      ]
    },
    "ToolStatus": {
      "type": "string",
      "enum": [
        "unspecified",
        "running",
        "completed",
        "error"
      ]
    },
    "Usage": {
      "description": "Token accounting for a turn, correlated to its message by `message_id`.\n`source` distinguishes the harness's persisted counts ([`UsageSource::Native`])\nfrom MITM wire-observed counts ([`UsageSource::Wire`]) so a consumer can\ndedupe across producers. Token fields are `Option` so \"0 tokens\" is\ndistinguishable from \"not reported\".",
      "type": "object",
      "properties": {
        "cacheCreationInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cacheReadInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "messageId": {
          "type": "string"
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/UsageSource"
        }
      },
      "required": [
        "messageId",
        "source"
      ]
    },
    "UsageSource": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unspecified"
          ]
        },
        {
          "description": "MITM wire-observed.",
          "type": "string",
          "const": "wire"
        },
        {
          "description": "Harness-persisted (transcript).",
          "type": "string",
          "const": "native"
        }
      ]
    }
  }
}
