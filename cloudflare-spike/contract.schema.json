{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "One event on a session's durable log. Envelope + a typed payload.\n\n`session_id` is the **partition key** — the durable identity that outlives\nthe sandboxes/runs/execs a session spans (see docs/session-event-log.md).\n`sandbox_id`/`run_id`/`exec_id` demote to optional *correlation*: which\nsandbox/run/exec a given line happened in.\n\n`seq` is monotonic **per session** and assigned by the session log on\nappend (the log is the seq authority), to DURABLE events only; ephemeral\ntelemetry carries `seq == 0` and is excluded from replay. Producers build\nevents via [`Event::session`] with `seq == 0` and let\n[`crate::events::log::SessionLog::append`] stamp it.",
  "type": "object",
  "properties": {
    "actor": {
      "description": "Who produced this event — stamped by the producer/gateway, never\nself-reported by the in-sandbox agent (the trust boundary; authz keys off\n`actor`). `None` on legacy/unattributed events. See [`Actor`].",
      "anyOf": [
        {
          "$ref": "#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ]
    },
    "at": {
      "description": "RFC3339 timestamp.",
      "type": "string"
    },
    "ephemeral": {
      "type": "boolean"
    },
    "execId": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    },
    "runId": {
      "type": "string"
    },
    "sandboxId": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "sessionId": {
      "type": "string"
    }
  },
  "required": [
    "seq",
    "at",
    "payload"
  ],
  "$defs": {
    "Actor": {
      "description": "Who produced an event. **Stamped by the producer/gateway from an authenticated\nsource, never self-reported by the in-sandbox agent** — unlike the old\n`host`/`sandbox` emitter tag, authz (who may drive / approve / join) keys off\n`actor`, so it is the trust boundary. See docs/session-event-log.md §Actor model.",
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "id": {
          "description": "Stable, kind-prefixed id (`a:<agent>`, `u:<user>`, `svc:<service>`,\n`pillbox`) — the [`Actor`] constructors apply the prefix.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "system",
        "service"
      ]
    },
    "AgentPhase": {
      "type": "string",
      "enum": [
        "unspecified",
        "queued",
        "thinking",
        "editing",
        "running_tool",
        "waiting_input",
        "done"
      ]
    },
    "Annotation": {
      "description": "An attributed, durable comment on a session that does NOT drive the agent —\nthe async, keyboard-free \"chime in\" (Slack-thread style). Unlike [`Input`] it\ncarries no driver semantics (anyone may annotate, no arbitration), so it's how\na non-driver participates; an orchestrator may optionally inject it as agent\ncontext. `anchor` is a free-form reference to what it's about (a seq, a path, a\nmessage id).",
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "Artifact": {
      "description": "A **structured session artifact** — a typed, durable output that is NOT an\nordinary agent message: a grader report, a judge critique, a dispatch\nworker summary, a code-exploration citation set, a self-harness proposal,\npatch metadata. The log line stays small (kind + summary + a content-\naddressed blob ref); the payload body lives in the session's blob store\n(`sessions/<id>/blobs/<sha256>`), dereferenced lazily — large tool output\nnever inlines into the spine. The enabling primitive for the eval loop, the\ndispatch evidence channel (#73), and any host-side tool (a FastContext\nexplorer, a grader) that wants to attach output without overloading the\ntranscript. See docs/session-event-log.md §Payload taxonomy / §Blob store.",
      "type": "object",
      "properties": {
        "blobRef": {
          "description": "The body, by reference: a content-addressed blob handle (sha256 hex) in\nthe session's blob store. The large payload never inlines into the log.",
          "type": "string"
        },
        "bytes": {
          "description": "Size of the referenced blob in bytes (0 if none).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "class": {
          "description": "Poolability class (docs/session-event-log.md §Content vs signal):\n`content` is local-only (raw code/output/critique); `signal` is the\nscrub-poolable metadata (scores, counts, names). Defaults to `content`\n— the safe default, so a body never egresses unless a producer asserts\nit is poolable signal.",
          "$ref": "#/$defs/ArtifactClass",
          "default": "content"
        },
        "contentType": {
          "description": "MIME-ish content type of the body (`application/json`, `text/plain`,\n`application/x-ndjson`, …). Empty = opaque bytes.",
          "type": "string"
        },
        "kind": {
          "description": "Typed kind in a dotted namespace: `eval.grader_report`, `judge.report`,\n`dispatch.worker_summary`, `code_explore.citations`,\n`self_harness.proposal`, `patch.summary`, … A free-form string (not an\nenum) so a new producer adds a kind without a contract bump; readers\nfilter by prefix.",
          "type": "string"
        },
        "summary": {
          "description": "One-line summary — enough to triage from the log without dereferencing\nthe blob.",
          "type": "string"
        },
        "workerId": {
          "description": "Worker correlation for fan-out artifacts (a dispatch worker id), so a\nreader can group a run's per-worker summaries. Empty when not applicable.",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "ArtifactClass": {
      "description": "The content-vs-signal poolability split (docs/session-event-log.md): a\nstructural gate so \"pool the metadata, not the code\" is enforced by the\nschema, not by remembering to redact. `Content` is the safe default.",
      "oneOf": [
        {
          "description": "Local-only: raw code, prompts, messages, tool I/O, critiques. Never egresses.",
          "type": "string",
          "const": "content"
        },
        {
          "description": "Poolable after scrub: scores, exit codes, pass/fail, counts, names.",
          "type": "string",
          "const": "signal"
        }
      ]
    },
    "AttentionReason": {
      "type": "string",
      "enum": [
        "unspecified",
        "needs_input",
        "error_stalled",
        "permission"
      ]
    },
    "AttentionRequired": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/AttentionReason"
        }
      },
      "required": [
        "reason",
        "message"
      ]
    },
    "Checkpoint": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "snapshotHandle": {
          "type": "string"
        }
      },
      "required": [
        "snapshotHandle"
      ]
    },
    "Criterion": {
      "description": "One rubric criterion's verdict: a named, independently-verifiable check\n(its own command exit) plus its captured output. The structured unit a\n`--rubric` grade decomposes into.",
      "type": "object",
      "properties": {
        "feedback": {
          "description": "The criterion command's combined output, tail-capped. Empty when it\nproduced none (e.g. a silent passing check).",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "passed": {
          "description": "The criterion's command exited 0.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed"
      ]
    },
    "Custom": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "payload": true
      },
      "required": [
        "name"
      ]
    },
    "EffectiveRuntimeLimitsEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contextWindowTokens": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "maxOutputTokens": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "reported"
            },
            "supportedReasoningProfiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/EvidenceUnavailableReason"
            },
            "status": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "EvidenceUnavailableReason": {
      "type": "string",
      "enum": [
        "not_reported",
        "unsupported",
        "redacted"
      ]
    },
    "ExecExit": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "code"
      ]
    },
    "ExecOutput": {
      "description": "`data` is base64-encoded bytes (matches the proto `bytes` field under\nprotobuf-JSON) so binary stdout survives the wire intact.",
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "stream": {
          "$ref": "#/$defs/StdStream"
        }
      },
      "required": [
        "stream",
        "data"
      ]
    },
    "ExecStarted": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "argv"
      ]
    },
    "Input": {
      "description": "A durable, attributed steer — the §0 record of `session send` (and the managed\ntier's `/input`). It is by definition a discrete *turn* (a submitted\nprompt/command), distinct from the live, ephemeral PTY keystroke\n(`Frame::Input`): this persists + replays + carries `actor`, so a late joiner\nsees who drove the agent and with what. (`data` for binary input is a future\naddition; `session send` is text today.)",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/InputTarget"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "target"
      ]
    },
    "InputTarget": {
      "description": "Where the steer goes: the agent's prompt channel, the raw PTY, or a one-off exec.",
      "type": "string",
      "enum": [
        "agent",
        "pty",
        "exec"
      ]
    },
    "MessageDelta": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "messageId",
        "text"
      ]
    },
    "MessageEnd": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "model": {
          "description": "The model that served the message; empty when unknown (e.g. a user\nturn or a harness that doesn't record it).",
          "type": "string"
        },
        "stopReason": {
          "description": "Why the message stopped (`end_turn`, `tool_use`, …); empty when unknown.",
          "type": "string"
        }
      },
      "required": [
        "messageId"
      ]
    },
    "MessageStart": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "messageId",
        "role"
      ]
    },
    "Payload": {
      "description": "Typed payload. Internally tagged on `type` (snake_case), so an\n`exec_output` serializes as `{\"type\":\"exec_output\",\"stream\":\"stdout\",...}`.",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SandboxProvisioned"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "sandbox_provisioned"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sandbox_ready"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SandboxDestroyed"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "sandbox_destroyed"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RunStarted"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run_started"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RunFinished"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run_finished"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RunFailed"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run_failed"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/MessageStart"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "message_start"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/MessageDelta"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "message_delta"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/MessageEnd"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "message_end"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ToolCall"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
